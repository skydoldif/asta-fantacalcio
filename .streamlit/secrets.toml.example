# Copia questo file in .streamlit/secrets.toml (locale) oppure incollane il
# contenuto nel pannello "Secrets" di Streamlit Community Cloud.
#
# .streamlit/secrets.toml e' nel .gitignore: non finisce mai in un commit.

# Password di Gestione asta. Sceglila lunga: chi ha il link pubblico vede
# comunque la voce nel menu, ma senza password non entra.
admin_password = "cambiami"

# Stringa di connessione Postgres.
# Su Supabase usa il *Transaction pooler* (porta 6543): il collegamento
# diretto e' solo IPv6 e Streamlit Cloud non lo raggiunge.
# Formato: postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
database_url = "postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Identificativo dell'asta sul database. Serve solo per tenerne piu' d'una
# sullo stesso database: se non lo imposti vale "main".
# auction_id = "2026-27"
